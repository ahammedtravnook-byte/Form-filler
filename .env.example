# Copy to .env and fill in values before running.

# REQUIRED in production — set to a strong random secret
PDF_API_ADMIN_API_KEY=change-me-in-production

# Path to the templates directory (default: ./templates relative to cwd)
# PDF_API_TEMPLATES_DIR=./templates

# Logging
PDF_API_LOG_LEVEL=INFO
PDF_API_LOG_JSON=false   # set to true in production for structured JSON logs

# Engine tweaks (leave as false in production)
PDF_API_DEBUG_BOXES=false
PDF_API_IGNORE_TEMPLATE_HASH=false
